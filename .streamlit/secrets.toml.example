# Secrets for Streamlit Community Cloud. Paste the filled-in version into the app's
# Settings → Secrets on share.streamlit.io. Never commit a real secrets.toml (it's gitignored).
#
# Locally you don't need this file: the app uses `gcloud auth application-default login`
# and reads settings from .env instead.

GCP_PROJECT_ID = "ba882-team10-inspections"
BQ_STAGING_DATASET = "dev_kaitran_staging"
USE_STUB_INSPECTIONS = "true"

# Service-account key with BigQuery Job User (project) + BigQuery Data Viewer (datasets).
# Copy every field from the downloaded JSON key file.
[gcp_service_account]
type = "service_account"
project_id = "ba882-team10-inspections"
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-dashboard@ba882-team10-inspections.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
